# .env.example
# Rename this file to `.env` and replace values with your actual API keys

# ───── Hugging Face API ─────
# Required for LLaMA-3 and CLIP inference (used in query_llm and image_search)
HF_TOKEN=your_huggingface_api_token_here

# ───── Serper API (Google Search Proxy) ─────
# Used in generic_scraper.py to get Google Shopping results
SERPER_API_KEY=your_serper_api_key_here

# ───── Optional Proxy Support ─────
# If scraping behind a proxy or using Tor, add your proxy URL here
# Leave empty if not using one
PROXY=socks5h://127.0.0.1:9050

# ───── Environment Options ─────
# Set to TRUE to enable debug logs in production
DEBUG=True
